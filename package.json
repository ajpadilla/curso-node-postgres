{
  "name": "my-store",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "jest",
    "test:api": "jest --config e2e/jest-e2e.json",
    "test:ui": "playwright test",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write app.js server.js index.js config database ecommerce frontend shared utils test e2e-ui",
    "format:check": "prettier --check app.js server.js index.js config database ecommerce frontend shared utils test e2e-ui",
    "db:generate": "sequelize-cli migration:generate --name",
    "db:migrate": "sequelize-cli db:migrate",
    "db:rollback": "sequelize-cli db:migrate:undo",
    "db:reset": "sequelize-cli db:migrate:undo:all",
    "db:seed:generate": "sequelize-cli seed:generate --name",
    "db:seed:run": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "db:seed:reset": "sequelize-cli db:seed:undo:all",
    "db:setup": "npm run db:migrate && npm run db:seed:run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.2.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.1",
    "jest": "^29.7.0",
    "nodemon": "^2.0.12",
    "prettier": "^2.8.8",
    "sequelize-cli": "^6.6.0",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@faker-js/faker": "^7.6.0",
    "@hapi/boom": "^9.1.4",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^4.0.1",
    "express": "^4.17.1",
    "express-ejs-layouts": "^2.5.1",
    "joi": "^17.4.2",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^6.9.2",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.10.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.31.1",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=18"
  }
}
